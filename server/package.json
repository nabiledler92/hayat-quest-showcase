{
  "name": "hayat-quest-server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:lab": "tsc -p tsconfig.json && node --env-file=.env.lab dist/index.js"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/monitor-opentelemetry": "^1.21.0",
    "@fastify/static": "^7.0.4",
    "@opentelemetry/api": "^1.9.1",
    "fastify": "^4.29.1",
    "openai": "^4.104.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
